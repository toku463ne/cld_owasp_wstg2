# WSTG Runner: nginx site. Rendered by scripts/setup-kali.sh into
# /etc/nginx/sites-available/wstg2.conf. Do not edit the rendered file by hand;
# change the config file (WSTG_CONFIG) or this template and run the script again.
#
# Placeholders (at sign + NAME + at sign): WEB_PORT, APP_PORT, ALLOW_RULES.
#
# Plain HTTP for now. TLS on 443 comes when the tool is opened to everyone.
server {
    listen @WEB_PORT@;
    listen [::]:@WEB_PORT@;
    server_name _;

    # Client networks (from WSTG_ALLOWED_NETWORKS). The app checks the same list.
@ALLOW_RULES@
    deny all;

    # Uploads: manual evidence (screenshots, files). Matches MAX_CONTENT_LENGTH.
    client_max_body_size 50m;
    server_tokens off;

    access_log /var/log/nginx/wstg2.access.log;
    error_log  /var/log/nginx/wstg2.error.log;

    location / {
        proxy_pass http://127.0.0.1:@APP_PORT@;
        # Keep the port in Host so redirects go back to :@WEB_PORT@.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        # Overwrite (not append): the app trusts exactly one proxy hop.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
