# WSTG Runner settings. Keep this file OUTSIDE the repository,
# for example ~/.config/wstg2/wstg2.env (chmod 600), and point WSTG_CONFIG at it.
# scripts/setup-kali.sh writes this file (and the secret key) if it is missing.

# Data (must be outside the repository; the app refuses to start otherwise)
WSTG_EVIDENCE_ROOT=/srv/wstg2/evidence
WSTG_DB_PATH=/srv/wstg2/db/wstg2.sqlite3

# Flask session key: generate with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))' > ~/.config/wstg2/secret_key; chmod 600 ~/.config/wstg2/secret_key
WSTG_SECRET_KEY_FILE=/home/kali/.config/wstg2/secret_key

# Loopback port of the app; nginx listens on WSTG_WEB_PORT and proxies here
WSTG_APP_PORT=5083

# nginx port (read by scripts/setup-kali.sh only)
WSTG_WEB_PORT=8083

# Client networks allowed (nginx enforces the same list)
WSTG_ALLOWED_NETWORKS=192.168.0.0/16,127.0.0.0/8

# Proxy for collection commands (empty = none), e.g. http://127.0.0.1:8080
WSTG_HTTP_PROXY=
