# WSTG Runner settings. Keep this file OUTSIDE the repository,
# for example ~/.config/wstg/wstg.env (chmod 600), and point WSTG_CONFIG at it.

# Data (must be outside the repository; the app refuses to start otherwise)
WSTG_EVIDENCE_ROOT=/srv/wstg/evidence
WSTG_DB_PATH=/srv/wstg/db/wstg.sqlite3

# Flask session key: generate with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))' > ~/.config/wstg/secret_key; chmod 600 ~/.config/wstg/secret_key
WSTG_SECRET_KEY_FILE=/home/kali/.config/wstg/secret_key

# Loopback port of the app; nginx listens on 8083 and proxies here
WSTG_APP_PORT=5083

# Client networks allowed (nginx enforces the same list)
WSTG_ALLOWED_NETWORKS=192.168.0.0/16,127.0.0.0/8
